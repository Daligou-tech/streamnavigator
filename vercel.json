{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "ignoreCommand": "bash scripts/vercel-gate.sh",
  "redirects": [
    {
      "source": "/streamnavigator-landing",
      "destination": "/streaming",
      "permanent": true
    },
    {
      "source": "/index_3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/refresh-shows",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/retry-failed-buying",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cleanup-staging-uploads",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cleanup-expired-documents",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/hoa-job",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/process-refunds",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/generate-paid-navigator",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/rental-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/landlord-reminders",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/get-navigator-submission.js": {
      "maxDuration": 300
    },
    "api/generate-contractor-report.js": {
      "maxDuration": 300
    },
    "api/generate-hoa-report.js": {
      "maxDuration": 800
    },
    "api/hoa-job.js": {
      "maxDuration": 800
    },
    "api/retry-failed-buying.js": {
      "maxDuration": 300
    },
    "api/email-report-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfkit,fontkit}/**"
    },
    "api/closing-scorecard.js": {
      "maxDuration": 300
    },
    "api/rental-reminders.js": {
      "maxDuration": 300
    },
    "api/generate-paid-navigator.js": {
      "maxDuration": 800
    }
  }
}
