{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/streamnavigator-landing",
      "destination": "/streaming",
      "permanent": true
    },
    {
      "source": "/index_3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/refresh-shows",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/retry-failed-buying",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/get-navigator-submission.js": {
      "maxDuration": 300
    },
    "api/generate-contractor-report.js": {
      "maxDuration": 300
    },
    "api/retry-failed-buying.js": {
      "maxDuration": 300
    },
    "api/email-report-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfkit,fontkit}/**"
    },
    "api/closing-scorecard.js": {
      "maxDuration": 300
    }
  }
}
